# Copier ce fichier en .env et remplir les valeurs. Ne jamais publier le fichier .env.

# Base de données PostgreSQL (Neon ou serveur OVH)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cave"
# Neon seulement : adresse directe (sans « -pooler ») pour les mises à jour du schéma (voir LISEZMOI, partie 4)
# DIRECT_URL=""

# Adresse publique du site, sans barre finale (sert aux liens des e-mails)
SITE_URL="http://localhost:3000"

# --- E-mails (Brevo) ---
# Clé d'API Brevo (Brevo > SMTP & API > Clés API). Sans clé, aucun e-mail ne part.
BREVO_API_KEY=""
# Expéditeur : adresse du domaine, à authentifier dans Brevo (SPF, DKIM, DMARC)
MAIL_FROM="contact@lacavebuissonniere.fr"
MAIL_FROM_NAME="La Cave Buissonnière"
# Destinataire des alertes (nouvelles commandes, devis). Par défaut : l'e-mail des réglages.
ALERT_EMAIL=""
# Sur un ordinateur de développement : écrire les e-mails dans un dossier au lieu de les envoyer
# MAIL_OUTBOX_DIR="boite-locale"

# --- Tâche quotidienne (rappels de la veille, nettoyage RGPD) ---
# Secret d'au moins 16 caractères, à générer (ex. : openssl rand -hex 24)
CRON_SECRET=""

# --- Paiement en ligne SumUp (laisser vide tant qu'il n'est pas branché) ---
SUMUP_API_KEY=""
SUMUP_MERCHANT_CODE=""
